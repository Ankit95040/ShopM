datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------
// 1. AUTHENTICATION & USERS
// ---------------------------------------------------------

enum UserRole {
  OWNER
  MANAGER
  EMPLOYEE
}

model Shop {
  id          String   @id @default(cuid())
  shopCode    String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members             ShopMember[]
  sessions            AuthSession[]
  locations           Location[]
  customers           Customer[]
  transactions        Transaction[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  stockMovements      StockMovement[]
  auditLogs           AuditLog[]

  @@index([shopCode])
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String
  emailVerified DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships         ShopMember[]
  sessions            AuthSession[]
  otpTokens           OtpToken[]
  locationsCreated    Location[]      @relation("LocationCreator")
  customersCreated    Customer[]      @relation("CustomerCreator")
  transactionsCreated Transaction[]   @relation("TransactionCreator")
  transactionsEdited  Transaction[]   @relation("TransactionEditor")
  stockMovements      StockMovement[] @relation("StockMovementCreator")
  inventoryItems      InventoryItem[] @relation("InventoryItemCreator")
  auditLogs           AuditLog[]

  @@index([email])
}

model ShopMember {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  loginId   String
  role      UserRole @default(EMPLOYEE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions  AuthSession[]

  @@unique([shopId, loginId])
  @@unique([shopId, userId])
  @@index([userId])
}

model AuthSession {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  shopId       String
  shopMemberId String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop         Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopMember   ShopMember @relation(fields: [shopMemberId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shopId])
  @@index([expiresAt])
}

model OtpToken {
  id           String   @id @default(cuid())
  userId       String
  email        String
  otpHash      String
  purpose      String   @default("forgot-password")
  attempts     Int      @default(0)
  maxAttempts  Int      @default(5)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
}

// ---------------------------------------------------------
// 2. LOCATIONS (SHOPS / WAREHOUSES)
// ---------------------------------------------------------

model Location {
  id          String          @id @default(cuid())
  shopId      String
  name        String          // e.g. "Meerut Shop", "Delhi Shop", "Warehouse"
  description String?
  isDeleted   Boolean         @default(false)
  deletedAt   DateTime?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  shop        Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy   User            @relation("LocationCreator", fields: [createdById], references: [id])
  customers   Customer[]
  inventory   InventoryItem[]

  @@index([shopId, isDeleted])
  @@index([shopId, name])
}

// ---------------------------------------------------------
// 3. CUSTOMERS
// ---------------------------------------------------------

model Customer {
  id          String        @id @default(cuid())
  shopId      String
  locationId  String
  name        String
  phone       String
  address     String?
  isDeleted   Boolean       @default(false)
  deletedAt   DateTime?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("CustomerCreator", fields: [createdById], references: [id])
  transactions Transaction[]

  @@index([shopId, isDeleted])
  @@index([locationId, isDeleted])
  @@index([shopId, phone])
  @@index([shopId, name])
}

// ---------------------------------------------------------
// 4. BILLING & CUSTOMER TRANSACTIONS (KHATA)
// ---------------------------------------------------------

enum TransactionType {
  DEBT             // Bill / Purchase on Credit
  PAYMENT_RECEIVED // Cash / UPI / Bank Transfer / Other
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

model Transaction {
  id                 String          @id @default(cuid())
  shopId             String
  customerId         String
  type               TransactionType
  amount             Decimal         @db.Decimal(14, 2)
  billNumber         String?         // Optional reference number
  paymentMethod      PaymentMethod?
  description        String?         // Notes
  billImageUrl       String?         // Cloudinary/Supabase asset URL (legacy)
  billImagePublicId  String?         // Storage file handle for deletion/replacement (legacy)
  billImageKey       String?         // R2 object key: transactions/{shopId}/{customerId}/{txId}.{ext}
  transactionDate    DateTime        @default(now())

  isDeleted          Boolean         @default(false)
  deletedAt          DateTime?
  deletedById        String?

  createdById        String
  updatedById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  shop               Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer           Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy          User            @relation("TransactionCreator", fields: [createdById], references: [id])
  updatedBy          User?           @relation("TransactionEditor", fields: [updatedById], references: [id])
  auditLogs          AuditLog[]

  @@index([shopId, isDeleted, transactionDate])
  @@index([customerId, isDeleted, transactionDate])
  @@index([shopId, type])
  @@index([shopId, billNumber])
}

// ---------------------------------------------------------
// 5. INVENTORY & CATEGORIES
// ---------------------------------------------------------

model InventoryCategory {
  id          String          @id @default(cuid())
  shopId      String
  name        String          // e.g. Cement, Steel, Electrical, Plumbing, Hardware
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  shop        Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items       InventoryItem[]

  @@unique([shopId, name])
  @@index([shopId, name])
}

model InventoryItem {
  id                String             @id @default(cuid())
  shopId            String
  locationId        String?
  categoryId        String
  name              String             // e.g. "UltraTech 50kg", "Wire 1.5mm"
  sku               String?            @unique
  unit              String             @default("Pieces") // Pieces, Boxes, Kg, Ton, Litres, Metres, Packs
  currentStock      Decimal            @default(0.00) @db.Decimal(12, 3)
  minStockThreshold Decimal            @default(5.00) @db.Decimal(12, 3)
  purchasePrice     Decimal?           @db.Decimal(12, 2)
  sellingPrice      Decimal?           @db.Decimal(12, 2)
  
  isDeleted         Boolean            @default(false)
  deletedAt         DateTime?
  
  createdById       String
  updatedById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category          InventoryCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  location          Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy         User               @relation("InventoryItemCreator", fields: [createdById], references: [id])
  movements         StockMovement[]

  @@index([shopId, isDeleted])
  @@index([shopId, categoryId, isDeleted])
  @@index([shopId, name])
  @@index([sku])
}

enum StockMovementType {
  ADD_STOCK
  REMOVE_STOCK
}

enum StockRemovalReason {
  SOLD
  DAMAGED
  LOST
  RETURNED
  ADJUSTMENT
  OTHER
}

model StockMovement {
  id            String              @id @default(cuid())
  shopId        String
  itemId        String
  type          StockMovementType
  removalReason StockRemovalReason?
  quantity      Decimal             @db.Decimal(12, 3)
  previousStock Decimal             @db.Decimal(12, 3)
  newStock      Decimal             @db.Decimal(12, 3)
  supplier      String?             // Optional for incoming stock
  purchasePrice Decimal?            @db.Decimal(12, 2)
  notes         String?
  movementDate  DateTime            @default(now())
  
  createdById   String
  createdAt     DateTime            @default(now())

  shop          Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  item          InventoryItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy     User                @relation("StockMovementCreator", fields: [createdById], references: [id])

  @@index([shopId, movementDate])
  @@index([itemId, movementDate])
}

// ---------------------------------------------------------
// 6. AUDIT LOGS (IMMUTABLE AUDIT TRAIL)
// ---------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  STOCK_CHANGE
}

model AuditLog {
  id            String       @id @default(cuid())
  shopId        String
  userId        String
  action        AuditAction
  entityType    String       // "TRANSACTION", "CUSTOMER", "LOCATION", "INVENTORY"
  entityId      String
  transactionId String?
  previousValue Json?        // Snapshot before edit
  newValue      Json?        // Snapshot after edit
  changeReason  String?
  ipAddress     String?
  createdAt     DateTime     @default(now())

  shop          Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}
