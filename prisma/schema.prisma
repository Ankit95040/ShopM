datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------
// 1. AUTHENTICATION & USERS
// ---------------------------------------------------------

enum UserRole {
  OWNER
  EMPLOYEE
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  role         UserRole  @default(EMPLOYEE)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  locationsCreated    Location[]      @relation("LocationCreator")
  customersCreated    Customer[]      @relation("CustomerCreator")
  transactionsCreated Transaction[]   @relation("TransactionCreator")
  transactionsEdited  Transaction[]   @relation("TransactionEditor")
  stockMovements      StockMovement[] @relation("StockMovementCreator")
  inventoryItems      InventoryItem[] @relation("InventoryItemCreator")
  auditLogs           AuditLog[]

  @@index([email])
}

// ---------------------------------------------------------
// 2. LOCATIONS (SHOPS / WAREHOUSES)
// ---------------------------------------------------------

model Location {
  id          String          @id @default(cuid())
  name        String          // e.g. "Meerut Shop", "Delhi Shop", "Warehouse"
  description String?
  isDeleted   Boolean         @default(false)
  deletedAt   DateTime?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy   User            @relation("LocationCreator", fields: [createdById], references: [id])
  customers   Customer[]
  inventory   InventoryItem[]

  @@index([name])
  @@index([isDeleted])
}

// ---------------------------------------------------------
// 3. CUSTOMERS
// ---------------------------------------------------------

model Customer {
  id          String        @id @default(cuid())
  locationId  String
  name        String
  phone       String
  address     String?
  isDeleted   Boolean       @default(false)
  deletedAt   DateTime?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("CustomerCreator", fields: [createdById], references: [id])
  transactions Transaction[]

  @@index([locationId, isDeleted])
  @@index([phone])
  @@index([name])
}

// ---------------------------------------------------------
// 4. BILLING & CUSTOMER TRANSACTIONS (KHATA)
// ---------------------------------------------------------

enum TransactionType {
  DEBT             // Bill / Purchase on Credit
  PAYMENT_RECEIVED // Cash / UPI / Bank Transfer / Other
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

model Transaction {
  id                 String          @id @default(cuid())
  customerId         String
  type               TransactionType
  amount             Decimal         @db.Decimal(14, 2)
  billNumber         String?         // Optional reference number
  paymentMethod      PaymentMethod?
  description        String?         // Notes
  billImageUrl       String?         // Cloudinary/Supabase asset URL
  billImagePublicId  String?         // Storage file handle for deletion/replacement
  transactionDate    DateTime        @default(now())

  isDeleted          Boolean         @default(false)
  deletedAt          DateTime?
  deletedById        String?

  createdById        String
  updatedById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  customer           Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy          User            @relation("TransactionCreator", fields: [createdById], references: [id])
  updatedBy          User?           @relation("TransactionEditor", fields: [updatedById], references: [id])
  auditLogs          AuditLog[]

  @@index([customerId, isDeleted, transactionDate])
  @@index([type])
  @@index([billNumber])
}

// ---------------------------------------------------------
// 5. INVENTORY & CATEGORIES
// ---------------------------------------------------------

model InventoryCategory {
  id          String          @id @default(cuid())
  name        String          @unique // e.g. Cement, Steel, Electrical, Plumbing, Hardware
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items       InventoryItem[]

  @@index([name])
}

model InventoryItem {
  id                String             @id @default(cuid())
  locationId        String?
  categoryId        String
  name              String             // e.g. "UltraTech 50kg", "Wire 1.5mm"
  sku               String?            @unique
  unit              String             @default("Pieces") // Pieces, Boxes, Kg, Ton, Litres, Metres, Packs
  currentStock      Decimal            @default(0.00) @db.Decimal(12, 3)
  minStockThreshold Decimal            @default(5.00) @db.Decimal(12, 3)
  purchasePrice     Decimal?           @db.Decimal(12, 2)
  sellingPrice      Decimal?           @db.Decimal(12, 2)
  
  isDeleted         Boolean            @default(false)
  deletedAt         DateTime?
  
  createdById       String
  updatedById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  category          InventoryCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  location          Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy         User               @relation("InventoryItemCreator", fields: [createdById], references: [id])
  movements         StockMovement[]

  @@index([categoryId, isDeleted])
  @@index([name])
  @@index([sku])
}

enum StockMovementType {
  ADD_STOCK
  REMOVE_STOCK
}

enum StockRemovalReason {
  SOLD
  DAMAGED
  LOST
  RETURNED
  ADJUSTMENT
  OTHER
}

model StockMovement {
  id            String              @id @default(cuid())
  itemId        String
  type          StockMovementType
  removalReason StockRemovalReason?
  quantity      Decimal             @db.Decimal(12, 3)
  previousStock Decimal             @db.Decimal(12, 3)
  newStock      Decimal             @db.Decimal(12, 3)
  supplier      String?             // Optional for incoming stock
  purchasePrice Decimal?            @db.Decimal(12, 2)
  notes         String?
  movementDate  DateTime            @default(now())
  
  createdById   String
  createdAt     DateTime            @default(now())

  item          InventoryItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy     User                @relation("StockMovementCreator", fields: [createdById], references: [id])

  @@index([itemId, movementDate])
}

// ---------------------------------------------------------
// 6. AUDIT LOGS (IMMUTABLE AUDIT TRAIL)
// ---------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  STOCK_CHANGE
}

model AuditLog {
  id            String       @id @default(cuid())
  userId        String
  action        AuditAction
  entityType    String       // "TRANSACTION", "CUSTOMER", "LOCATION", "INVENTORY"
  entityId      String
  transactionId String?
  previousValue Json?        // Snapshot before edit
  newValue      Json?        // Snapshot after edit
  changeReason  String?
  ipAddress     String?
  createdAt     DateTime     @default(now())

  user          User         @relation(fields: [userId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}
